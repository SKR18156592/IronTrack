# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Without them, the app uses the project hard-coded in src/sync.js.
# Never put the service_role key here: these values end up in the public bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
